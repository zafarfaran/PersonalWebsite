# Copy this file to .env and fill in your details.
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
FROM_NAME=Your Name

# Inbox watching (auto status updates + alerts). Uses the same user/password.
IMAP_HOST=imap.gmail.com
IMAP_POLL_MINUTES=10

# Outlook/Hotmail instead:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   IMAP_HOST=outlook.office365.com
